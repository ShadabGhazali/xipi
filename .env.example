# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# OpenAI (for GPT-4o transfer evaluation)
OPENAI_API_KEY=sk-...your-key...

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=xipi-local-secret

# vLLM server (main model — Llama-3-70B)
VLLM_HOST=localhost
VLLM_PORT=8000
VLLM_MODEL=meta-llama/Meta-Llama-3-70B-Instruct

# vLLM verifier server (Layer 3 — Qwen2.5-1.5B)
VERIFIER_PORT=8005

# Mock actuator endpoints
HR_API_URL=http://localhost:8001
DEVOPS_API_URL=http://localhost:8002
ATTACKER_WEBHOOK=http://localhost:9999

# Experiment control
RANDOM_SEED=42
NUM_TRIALS=50
